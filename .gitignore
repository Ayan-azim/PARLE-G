# Local configuration and credentials
.env
.env.*
!.env.example
**/.streamlit/secrets.toml

# Local IDE and operating-system files
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.swp
*.swo
*~

# Streamlit and generated run output
