**/app/report/output/
*.log
*.tmp
*.temp
tmp/
temp/

# Large local video inputs and generated recordings.
# Keep curated videos out of Git unless they are deliberately added with Git LFS.
*.mp4
*.m4v
*.mov
*.avi
*.mkv
*.webm

# Model checkpoints and exported weights; keep the two active detector weights.
*.pt
*.pth
*.onnx
*.weights
*.ckpt
!models/weights/yolo11s.pt
!models/weights/indian_plate_best.pt

# Old smoke-test images and duplicate archive bundles
backend/legacy/smoke_plate_*.jpg
backend/legacy/*.zip
